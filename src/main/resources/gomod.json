{
  "id": "${id}",
  "version": "${version}",
  "name": "Gopher",
  "description": "A tour of GoCraft: items, blocks, commands, events, hooks, goroutines and a recipe, all in Go.",
  "authors": ["The GoCraft Authors"],
  "license": "BSD-3-Clause",
  "icon": "assets/gopher/icon.png",
  "environment": "*",
  "depends": {
    "minecraft": ">=${minecraft_version}",
    "gocraft": "*",
    "fabric-api": "*"
  },
  "hooks": [
    {
      "id": "motd",
      "target": "net.minecraft.server.MinecraftServer",
      "method": "getMotd",
      "desc": "()Ljava/lang/String;",
      "at": "RETURN"
    }
  ]
}
